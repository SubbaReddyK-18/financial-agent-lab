# ==================================================
# Financial Agent Lab — Environment Variables
# ==================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ----- Database -----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=financial_agent_lab
DB_USER=fal_user
DB_PASSWORD=changeme_local_only

# Constructed automatically from the above in settings.py.
# You can override the full URL here if preferred:
# DATABASE_URL=postgresql+asyncpg://fal_user:changeme@localhost:5432/financial_agent_lab

# ----- Application -----
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# ----- API -----
API_HOST=0.0.0.0
API_PORT=8000

# ----- Razorpay Webhook Gateway -----
RAZORPAY_WEBHOOK_SECRET=test_webhook_secret_local

# ----- Block 4 AI Recovery Decision Agent -----
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
AI_API_KEY=your_google_api_key_here
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_TIMEOUT_SECONDS=15.0
AI_COST_PER_MILLION_INPUT_TOKENS_USD=0.075
AI_COST_PER_MILLION_OUTPUT_TOKENS_USD=0.30
USD_TO_INR_RATE=85.0
